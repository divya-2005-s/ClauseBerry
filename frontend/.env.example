# URL of the FastAPI backend that Next.js proxies /api/* to (server-side only, never exposed to the browser)
BACKEND_URL=http://127.0.0.1:8000

# Optional, dev server only: extra hostnames allowed to load the dev site, e.g. your PC's LAN IP
# when opening it from a phone on the same Wi-Fi (comma separated, no scheme or port).
# ALLOWED_DEV_ORIGINS=192.168.1.20
