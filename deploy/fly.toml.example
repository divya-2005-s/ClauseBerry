# Example Fly.io configuration for the ClauseBerry API. Copy to fly.toml and set `app` and `primary_region`.
# Not used by anything automatically; creating the app and volume is a manual, billable step.
app = "your-clauseberry-api"
primary_region = "iad"          # Fly's lowest-priced regions are iad/ewr; prices vary by region

[build]
  dockerfile = "Dockerfile"

[env]
  APP_ENV = "production"
  PORT = "8080"
  # FRONTEND_URL / CORS_ORIGINS / TRUSTED_PROXY_HOPS: set with `fly secrets set` or here once known.

[mounts]
  source = "clauseberry_data"   # fly volumes create clauseberry_data --size 3 --region iad
  destination = "/data"         # SQLite DB, Chroma index and model cache live here

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"    # always on: SQLite + in-memory rate limits assume one long-lived instance
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    method = "GET"
    path = "/api/health"
    interval = "30s"
    timeout = "5s"
    grace_period = "60s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "1gb"                # measured ~564 MiB RSS while answering a question; 512 MB is not enough
