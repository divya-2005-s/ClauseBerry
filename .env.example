# ClauseBerry backend + pipeline configuration. Copy to .env (never commit .env).

# development | production | test
APP_ENV=development
# Public URL of the frontend (used in email links)
FRONTEND_URL=http://localhost:3000
# Comma-separated origins allowed to call the API directly (the Next.js proxy is same-origin)
CORS_ORIGINS=http://localhost:3000
# Local policy monitoring starts with the API and checks on this interval.
POLICY_MONITORING_ENABLED=true
POLICY_CHECK_INTERVAL_HOURS=24
# Force secure cookies (defaults to true when APP_ENV=production)
# COOKIE_SECURE=true

# Storage (defaults shown). Point these at a persistent volume in production.
# CLAUSEBERRY_DB_PATH=data/clauseberry.db
# CLAUSEBERRY_CHROMA_PATH=data/chroma

# LLM analysis and generative chat answers (optional; rule-based + extractive fallback without it)
GEMINI_API_KEY=
# Google limits 2.5-series access to accounts that used them recently; new keys may need a newer model.
# Run `python scripts/check_gemini.py --list-only` to see the models your key can use.
GEMINI_MODEL=gemini-2.5-flash

# Email delivery via Resend (optional; emails are logged to the local outbox without it)
RESEND_API_KEY=
EMAIL_FROM=ClauseBerry <alerts@your-verified-domain.example>

# Embeddings / chunking
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_WORDS=220
RAG_CHUNK_OVERLAP=40

# Policy fetcher: identify yourself to site operators
FETCH_USER_AGENT=ClauseBerryBot/1.0 (+https://your-site.example/bot; contact: you@example.com)

# Rate limits
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_ASK_PER_10MIN=20
RATE_LIMIT_LOGIN_PER_ACCOUNT_15MIN=20
# Number of proxies in front of the API whose X-Forwarded-For entries are trusted for per-IP limits.
# 0 (default) ignores the header entirely. Set only after confirming the real chain on your host
# Keep 0 behind the Next.js /api proxy: it forwards any client-sent X-Forwarded-For unchanged.
TRUSTED_PROXY_HOPS=0
